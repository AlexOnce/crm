<IfModule mod_rewrite.c>
    RewriteEngine On
    # Si la petición no entra por la carpeta public, redirigir internamente a public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Seguridad: Bloquear acceso a archivos sensibles y de configuración
<FilesMatch "^\.|\.(env|git|log|ini|sh|bak|sql|yaml|yml|ps1)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
